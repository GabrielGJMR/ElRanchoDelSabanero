# Copie este archivo a .env y complete sus propios valores. .env NO se sube a git.

# Dominio con el DNS tipo A (y www) apuntando a la IP del VPS; Caddy pide el certificado
# de Let's Encrypt automáticamente para este dominio al arrancar.
DOMAIN=tudominio.com

# Base de datos
DB_NAME=rancho
DB_USER=rancho
DB_PASSWORD=cambie-esta-clave-larga-y-unica

# Panel de administración (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=cambie-esta-otra-clave-larga

# Días que se conservan los respaldos de la base de datos en ./backups
BACKUP_KEEP_DAYS=14
